# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adm_dev
DB_MIGRATOR_USER=adm_migrator
DB_MIGRATOR_PASSWORD=__MIGRATOR_PASSWORD__
DB_APP_USER=adm_app
DB_APP_PASSWORD=__APP_PASSWORD__
DB_SSLMODE=disable

# JWT
JWT_SECRET=__JWT_SECRET__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Short-lived signed URL (HMAC) for /stream and /download
SIGNED_URL_SECRET=__SIGNED_URL_SECRET__
SIGNED_URL_TTL_SECONDS=300

# .lic file HMAC secret
LICENSE_SECRET=__LICENSE_SECRET__

# Storage
STORAGE_BACKEND=local
STORAGE_DIR=/Users/sasata/adm_storage/sounds

# Audio constraints (FR-STREAM-06)
PREVIEW_DURATION_SEC=10
MAX_SAMPLE_RATE=48000
MAX_BIT_DEPTH=24

# CORS (Nuxt dev server)
CORS_ORIGINS=http://localhost:3000
